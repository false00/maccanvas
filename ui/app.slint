import { LineEdit, ComboBox, ScrollView, Palette } from "std-widgets.slint";
import { GlassTheme, GlassPanel, Button, CheckBox, Slider } from "glass.slint";
import { AboutOverlay } from "about.slint";
import { ClipboardOverlay } from "clipboard.slint";
import { AudioOverlay } from "audio.slint";
import { FilesOverlay, FileRow } from "files.slint";

export struct Machine { name: string, detail: string, saved: bool }
export struct TrafficBar { download: float, upload: float }
export struct CodecGuide { name: string, detail: string, estimate: string }

component Caption inherits Text {
    color: Palette.foreground;
    font-size: 12px;
    font-weight: 600;
    height: 20px;
    vertical-alignment: center;
}

component TrafficPlot inherits Rectangle {
    in property <[TrafficBar]> samples;
    in property <color> incoming: GlassTheme.accent;
    in property <color> outgoing: #8e8e93;
    in property <bool> motion: true;
    background: transparent;
    HorizontalLayout {
        spacing: 1px;
        for sample in root.samples : Rectangle {
            background: transparent;
            Rectangle {
                x: 0px; width: parent.width / 2;
                height: max(1px, sample.download * (parent.height - 2px));
                y: parent.height - self.height;
                background: root.incoming;
                opacity: sample.download > 0 ? 1 : 0.15;
                animate height, opacity { duration: root.motion ? 220ms : 0ms; easing: ease-out; }
            }
            Rectangle {
                x: parent.width / 2; width: parent.width / 2;
                height: max(1px, sample.upload * (parent.height - 2px));
                y: parent.height - self.height;
                background: root.outgoing;
                opacity: sample.upload > 0 ? 1 : 0.15;
                animate height, opacity { duration: root.motion ? 220ms : 0ms; easing: ease-out; }
            }
        }
    }
}

export component App inherits Window {
    title: "MacCanvas";
    icon: @image-url("../assets/logo.svg");
    preferred-width: 1240px;
    preferred-height: 820px;
    min-width: 820px;
    min-height: 560px;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    in-out property <string> machine-name;
    in-out property <string> host;
    in-out property <string> port: "5900";
    in-out property <string> username;
    in-out property <string> password;
    in-out property <int> auth-mode: 0;
    in-out property <bool> remember-password: false;
    in-out property <bool> use-saved: false;
    in property <bool> has-saved: false;
    in-out property <bool> ctrl-as-command: true;
    in property <bool> dark-theme: false;
    in property <bool> motion-enabled: true;
    in property <bool> glass-enabled: true;
    in-out property <bool> sidebar-open: true;
    in-out property <bool> editor-open: true;
    in-out property <bool> show-fps: true;
    in-out property <string> machine-filter;
    in property <[Machine]> machines;
    in property <int> selected: -1;
    in property <bool> connected: false;
    in property <bool> connecting: false;
    in property <bool> immersive: false;
    in property <bool> pulse: false;
    in property <string> app-version;
    in property <string> build-date;
    in property <string> build-revision;
    in property <string> build-target;
    in property <string> build-compiler;
    in property <string> author-name;
    in property <string> log-path;
    in property <string> audit-error;
    in-out property <bool> about-open: false;
    in-out property <bool> clipboard-open: false;
    in-out property <bool> clipboard-shared: false;
    in property <string> clipboard-mode: "Standard VNC: Latin-1 compatibility mode.";
    in-out property <bool> files-open: false;
    in property <string> files-host;
    in-out property <string> files-port: "22";
    in-out property <string> files-username;
    in-out property <string> files-password;
    in property <bool> files-has-saved;
    in-out property <bool> files-use-saved;
    in property <bool> files-connected;
    in property <bool> hevc-active;
    in-out property <bool> audio-open: false;
    in-out property <bool> audio-muted: false;
    in-out property <float> audio-volume: 100;
    in property <bool> audio-codec-missing: false;
    in property <bool> audio-installing: false;
    in property <string> audio-status: "Audio is available with HEVC.";
    in property <bool> files-directory-ready;
    in property <bool> files-connecting;
    in property <bool> files-busy;
    in property <bool> files-key-pending;
    in property <string> files-fingerprint;
    in property <string> files-key-algorithm;
    in property <string> files-key-command;
    in-out property <string> files-path;
    in-out property <string> files-upload-name;
    in property <[FileRow]> file-entries;
    in property <string> files-status;
    in property <string> files-error;
    in property <string> files-progress-label;
    in property <float> files-progress;
    out property <bool> modal-open: quality-open || help-open || about-open || clipboard-open || files-open || audio-open || update-installing;
    out property <bool> canvas-focused: remote-focus.has-focus;
    in property <bool> update-checking: false;
    in property <bool> update-available: false;
    in property <bool> update-installing: false;
    in property <bool> update-restart-required: false;
    in property <bool> update-banner: false;
    in property <string> update-status: "Checking for updates on launch...";
    in property <string> update-version;
    in property <float> update-progress;
    in property <string> status: "Ready to connect";
    in-out property <string> error-text;
    in property <string> desktop-description;
    in property <image> frame-image;
    in property <float> draw-left;
    in property <float> draw-top;
    in property <float> draw-width;
    in property <float> draw-height;
    in property <string> download-rate: "0.0 kbps";
    in property <string> upload-rate: "0.0 kbps";
    in property <string> fps-text: "0 FPS";
    in property <[TrafficBar]> traffic;
    in property <string> active-encoding: "Waiting for pixels";
    in-out property <int> encoding-index: 0;
    in-out property <float> compression-level: 6;
    in-out property <float> jpeg-quality: 8;
    in-out property <bool> manual-bandwidth: false;
    in-out property <string> target-mbps: "10";
    in-out property <bool> manual-hevc-bitrate: false;
    in-out property <string> hevc-mbps: "60";
    in-out property <string> max-fps: "60";
    in property <string> encoding-description;
    in property <string> bandwidth-description: "Default: HEVC / H.265, adaptive bitrate, up to 60 FPS.";
    in property <[CodecGuide]> codec-guide;
    in property <string> estimate-context;
    in-out property <bool> quality-open: false;
    in-out property <bool> help-open: false;
    in-out property <bool> confirm-delete: false;
    out property <float> canvas-width: canvas.width / 1px;
    out property <float> canvas-height: canvas.height / 1px;
    in property <image> remote-cursor-image;
    in property <bool> remote-cursor-ready: false;
    in property <bool> remote-cursor-hidden: false;
    in property <float> remote-cursor-width;
    in property <float> remote-cursor-height;
    in property <float> remote-cursor-hotspot-x;
    in property <float> remote-cursor-hotspot-y;
    in property <float> remote-cursor-scale: 1;
    in property <float> remote-cursor-frame-width: 1;
    private property <float> remote-cursor-zoom: Math.min(4, Math.max(0.125, root.remote-cursor-scale * root.draw-width / Math.max(1, root.remote-cursor-frame-width)));

    callback connect-requested();
    callback disconnect-requested();
    callback save-machine();
    callback new-machine();
    callback delete-machine();
    callback select-machine(int);
    callback quick-connect(int);
    callback filter-machines();
    callback save-preferences();
    callback quality-changed();
    callback apply-streaming();
    callback audio-changed();
    callback audio-install();
    callback audio-retry();
    callback reset-streaming();
    callback refresh-desktop();
    callback fullscreen-requested();
    callback canvas-resized();
    callback video-frame-ready();
    callback pointer-event(float, float, PointerEvent);
    callback wheel-event(float, float, PointerScrollEvent);
    callback keyboard-event(KeyEvent, bool) -> bool;
    callback release-input();
    callback focus-canvas();
    callback check-updates();
    callback install-update();
    callback dismiss-update();
    callback about-link(int);
    callback open-logs();
    callback clipboard-changed();
    callback paste-windows-text();
    callback open-clipboard();
    callback close-clipboard();
    callback open-files();
    callback files-close();
    callback files-connect();
    callback files-disconnect();
    callback files-approve(bool);
    callback files-browse();
    callback files-up();
    callback files-entry(int);
    callback files-upload();
    callback files-cancel();
    callback files-copy-text();
    callback files-send-text();

    init => {
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
        GlassTheme.dark = root.dark-theme;
        GlassTheme.motion = root.motion-enabled;
        GlassTheme.effects = root.glass-enabled;
    }
    changed dark-theme => {
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
        GlassTheme.dark = root.dark-theme;
    }
    changed motion-enabled => { GlassTheme.motion = root.motion-enabled; }
    changed glass-enabled => { GlassTheme.effects = root.glass-enabled; }
    changed canvas-width => { root.canvas-resized(); }
    changed canvas-height => { root.canvas-resized(); }
    changed encoding-index => { root.quality-changed(); }
    changed machine-filter => { root.filter-machines(); }
    changed use-saved => { root.username = ""; root.password = ""; }
    changed files-use-saved => { root.files-username = ""; root.files-password = ""; }
    focus-canvas => { remote-focus.focus(); }

    background: root.dark-theme ? #000000 : #f2f2f7;
    property <color> panel: root.dark-theme ? #1c1c1e : #ffffff;
    property <color> outline: root.dark-theme ? #48484a : #d1d1d6;
    property <color> muted: GlassTheme.muted;
    property <color> ink: GlassTheme.ink;
    property <color> accent: GlassTheme.accent;
    property <color> selection: root.dark-theme ? #0a84ff1f : #007aff0c;
    FocusScope {
        enabled: !root.modal-open;
    VerticalLayout {
        spacing: root.immersive ? 0px : 12px;
        padding: root.immersive ? 0px : 12px;
        if !root.immersive : GlassPanel {
            height: 68px;
            radius: 20px;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px;
                padding-top: 14px; padding-bottom: 14px; spacing: 10px;
                Button {
                    accessible-label: "Toggle connections sidebar";
                    icon: @image-url("../assets/sidebar.svg"); quiet: !root.sidebar-open;
                    clicked => { root.sidebar-open = !root.sidebar-open; root.save-preferences(); }
                }
                Image { source: @image-url("../assets/logo.svg"); width: 40px; height: 40px; }
                VerticalLayout {
                    spacing: 0px;
                    Text { text: "MacCanvas"; color: root.ink; font-size: 19px; font-weight: 700; }
                    Text { text: "A little closer to your Mac."; color: root.muted; font-size: 11px; }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button { text: "Quality"; icon: @image-url("../assets/tune.svg"); accessible-label: "Stream quality"; clicked => { root.quality-open = true; root.release-input(); } }
                Button { icon: @image-url("../assets/audio.svg"); accessible-label: "Audio playback"; quiet: root.audio-muted; clicked => { root.audio-open = true; root.release-input(); } }
                Button { icon: @image-url("../assets/clipboard.svg"); accessible-label: "Clipboard sharing"; quiet: true; enabled: root.connected; clicked => { root.open-clipboard(); } }
                Button { text: "Files"; icon: @image-url("../assets/folder.svg"); accessible-label: "File transfer"; quiet: !root.files-connected; enabled: root.connected; clicked => { root.open-files(); } }
                Button { icon: @image-url("../assets/info.svg"); accessible-label: "About MacCanvas"; quiet: true; clicked => { root.about-open = true; root.release-input(); } }
                Button { accessible-label: "Refresh"; icon: @image-url("../assets/refresh.svg"); quiet: true; enabled: root.connected; clicked => { root.refresh-desktop(); } }
                Button { accessible-label: "Full screen"; icon: @image-url("../assets/fullscreen.svg"); quiet: true; enabled: root.connected; clicked => { root.fullscreen-requested(); } }
                Button { text: root.connecting ? "Cancel" : "Disconnect"; enabled: root.connected || root.connecting; clicked => { root.disconnect-requested(); } }
            }
        }
        HorizontalLayout {
            padding-left: 0px; padding-right: 0px; padding-top: 0px;
            spacing: root.sidebar-open && !root.immersive ? 14px : 0px;
            sidebar := Rectangle {
                width: root.sidebar-open && !root.immersive ? 320px : 0px;
                border-radius: 20px;
                clip: true;
                background: transparent;
                animate width { duration: root.motion-enabled ? 200ms : 0ms; easing: ease-in-out; }
                GlassPanel {
                    width: 320px;
                    height: parent.height;
                    radius: sidebar.border-radius;
                    opacity: min(1, sidebar.width / 240px);
                    visible: sidebar.width > 1px;
                    ScrollView {
                        VerticalLayout {
                            padding: 18px; spacing: 10px;
                            HorizontalLayout {
                                Caption { text: root.editor-open ? (root.selected >= 0 ? "MAC DETAILS" : "NEW CONNECTION") : "YOUR MACS"; color: root.muted; }
                                Button {
                                    text: root.editor-open ? "All Macs" : "New";
                                    accessible-label: root.editor-open ? "Show saved Macs" : "New connection";
                                    enabled: !root.connecting;
                                    clicked => {
                                        root.confirm-delete = false;
                                        if root.editor-open { root.editor-open = false; }
                                        else if !root.connected { root.new-machine(); }
                                    }
                                }
                            }
                            if !root.editor-open : VerticalLayout {
                                spacing: 10px;
                                LineEdit { accessible-label: "Search saved Macs"; height: 34px; text <=> root.machine-filter; placeholder-text: "Search by name or address"; }
                                if root.machines.length == 0 : Text {
                                    text: root.machine-filter == "" ? "Your Macs, one click away.\nAdd your first Mac to get started." : "No Macs match this search.";
                                    color: root.muted; wrap: word-wrap;
                                }
                                for machine[index] in root.machines : GlassPanel {
                                    height: 116px;
                                    radius: 14px;
                                    background: root.selected == index ? root.selection : (root.dark-theme ? #2c2c2e99 : #f2f2f7b3);
                                    border-color: root.selected == index ? root.accent : GlassTheme.edge;
                                    animate background { duration: root.motion-enabled ? 140ms : 0ms; }
                                    VerticalLayout {
                                        padding: 12px; spacing: 5px;
                                        HorizontalLayout {
                                            Image { source: @image-url("../assets/logo-mark.svg"); width: 24px; height: 24px; }
                                            Text { text: machine.name; color: root.ink; font-weight: 600; overflow: elide; vertical-alignment: center; }
                                        }
                                        Text { text: machine.detail; color: root.muted; font-size: 11px; overflow: elide; }
                                        HorizontalLayout {
                                            Text { text: machine.saved ? "Hello protected" : "Manual sign-in"; color: root.accent; font-size: 11px; vertical-alignment: center; }
                                            Button { text: "Details"; quiet: true; enabled: !root.connected && !root.connecting; clicked => { root.select-machine(index); } }
                                            Button {
                                                text: machine.saved ? "Connect" : "Open";
                                                primary: true; enabled: !root.connected && !root.connecting;
                                                clicked => { root.quick-connect(index); }
                                            }
                                        }
                                    }
                                }
                                Button {
                                    height: 34px; text: "Add a Mac"; accessible-label: "Add a Mac";
                                    enabled: !root.connected && !root.connecting;
                                    clicked => { root.new-machine(); }
                                }
                            }
                            if root.editor-open : VerticalLayout {
                                spacing: 8px;
                                if root.connected : Text { text: "Disconnect before changing this Mac's details."; color: root.muted; wrap: word-wrap; }
                                Caption { text: "Name"; }
                                LineEdit { accessible-label: "Machine name"; text <=> root.machine-name; placeholder-text: "Mac mini"; enabled: !root.connected && !root.connecting; }
                                Caption { text: "Host or IP address"; }
                                LineEdit { accessible-label: "Mac address"; text <=> root.host; placeholder-text: "192.168.1.50"; enabled: !root.has-saved && !root.connected && !root.connecting; }
                                HorizontalLayout {
                                    Caption { text: "Port"; }
                                    LineEdit { accessible-label: "VNC port"; width: 88px; text <=> root.port; input-type: InputType.number; enabled: !root.has-saved && !root.connected && !root.connecting; }
                                }
                                Caption { text: "Login method"; }
                                ComboBox {
                                    accessible-label: "Login method"; model: ["Mac account", "VNC password"];
                                    current-index <=> root.auth-mode; enabled: !root.has-saved && !root.connected && !root.connecting;
                                }
                                if root.has-saved && root.use-saved : GlassPanel {
                                    height: 140px; radius: 14px; background: root.selection;
                                    VerticalLayout {
                                        padding: 12px; spacing: 6px;
                                        Caption { text: "Saved login is locked"; color: root.accent; }
                                        Text { text: "Windows Hello is required every time. Saved passwords cannot be displayed."; color: root.ink; font-size: 12px; wrap: word-wrap; }
                                        Button {
                                            text: "Enter different credentials";
                                            enabled: !root.connected && !root.connecting;
                                            clicked => { root.use-saved = false; }
                                        }
                                    }
                                }
                                if !root.use-saved : VerticalLayout {
                                    spacing: 8px;
                                    if root.auth-mode == 0 : VerticalLayout {
                                        spacing: 6px;
                                        Caption { text: "Mac username"; }
                                        LineEdit { accessible-label: "Mac username"; text <=> root.username; placeholder-text: "Your macOS account"; enabled: !root.connected && !root.connecting; }
                                    }
                                    Caption { text: "Password"; }
                                    LineEdit { accessible-label: "Mac password"; text <=> root.password; input-type: InputType.password; placeholder-text: "Enter a password"; enabled: !root.connected && !root.connecting; }
                                    CheckBox {
                                        text: root.has-saved ? "Replace saved login after connecting" : "Save login in Credential Manager";
                                        checked <=> root.remember-password; enabled: !root.connected && !root.connecting;
                                    }
                                    if root.has-saved : Button {
                                        text: "Use Hello-protected saved login";
                                        enabled: !root.connected && !root.connecting;
                                        clicked => { root.use-saved = true; }
                                    }
                                }
                                Button {
                                    text: root.connecting ? "Connecting..." : (root.use-saved ? "Unlock & connect" : "Connect to Mac");
                                    accessible-label: "Connect to Mac"; primary: true;
                                    enabled: !root.connected && !root.connecting && root.host != "" && (root.use-saved || root.password != "");
                                    clicked => { root.connect-requested(); }
                                }
                                HorizontalLayout {
                                    Button { text: "Save details"; accessible-label: "Save machine"; enabled: !root.connected && !root.connecting; clicked => { root.save-machine(); } }
                                    Button { text: "Remove"; enabled: root.selected >= 0 && !root.connected && !root.connecting; clicked => { root.confirm-delete = !root.confirm-delete; } }
                                }
                                if root.confirm-delete : VerticalLayout {
                                    Text { text: "Remove this Mac and its saved login?"; color: root.ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        Button { text: "Keep Mac"; clicked => { root.confirm-delete = false; } }
                                        Button { text: "Remove Mac"; clicked => { root.delete-machine(); root.confirm-delete = false; } }
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: root.outline; }
                            CheckBox { text: "Ctrl shortcuts act as Command"; checked <=> root.ctrl-as-command; toggled => { root.save-preferences(); } }
                            Text { text: "Saved logins always require Windows Hello. Theme follows Windows automatically."; color: root.muted; font-size: 11px; wrap: word-wrap; }
                            Text { text: "Use a VPN for remote access. Standard Mac VNC traffic is not encrypted."; color: root.muted; font-size: 11px; wrap: word-wrap; }
                            Rectangle { height: 1px; background: root.outline; }
                            HorizontalLayout {
                                Text { text: "MacCanvas " + root.app-version; color: root.muted; font-size: 11px; vertical-alignment: center; }
                                Button {
                                    text: root.update-checking ? "Checking..." : (root.update-available ? "Update" : "Check updates");
                                    accessible-label: "Check for updates";
                                    enabled: !root.update-checking && !root.update-installing && !root.update-restart-required;
                                    clicked => { root.check-updates(); }
                                }
                            }
                            Text { accessible-label: "Update status: " + root.update-status; text: root.update-status; color: root.muted; font-size: 11px; wrap: word-wrap; }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 10px;
                if root.audit-error != "" : Rectangle {
                    background: root.dark-theme ? #ff453a19 : #ff3b3010;
                    border-radius: 8px; min-height: 60px;
                    Text { x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px; text: root.audit-error; color: root.ink; wrap: word-wrap; font-size: 12px; }
                }
                if root.error-text != "" : Rectangle {
                    background: root.dark-theme ? #ff453a19 : #ff3b3010;
                    border-radius: 8px; min-height: 54px;
                    HorizontalLayout {
                        padding: 12px; spacing: 8px;
                        Text { text: root.error-text; color: root.dark-theme ? #ff6961 : #b42318; wrap: word-wrap; }
                        Button { text: "Dismiss"; clicked => { root.error-text = ""; } }
                    }
                }
                canvas := Rectangle {
                    accessible-role: groupbox; accessible-label: "Remote desktop";
                    vertical-stretch: 1; horizontal-stretch: 1;
                    border-radius: root.immersive ? 0px : 20px;
                    border-width: root.immersive ? 0px : 1px;
                    border-color: GlassTheme.edge;
                    background: root.connected || root.immersive ? #000000 : (root.dark-theme ? #111111c9 : #ffffffd9); clip: true;
                    if !root.connected : VerticalLayout {
                        alignment: center; padding: 30px; spacing: 14px;
                        Rectangle {
                            height: 92px; background: transparent;
                            Image { source: @image-url("../assets/logo.svg"); width: 92px; height: 92px; x: (parent.width - self.width) / 2; }
                        }
                        Text { text: root.connecting ? "A moment closer." : "Your Mac, beautifully in view."; color: root.ink; font-size: 27px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
                        Text { text: root.connecting ? "Verify with Windows Hello if prompted." : "Choose a saved Mac or add a new connection."; color: root.muted; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: center;
                            Button { width: 200px; text: "New connection"; primary: true; enabled: !root.connecting; clicked => { root.new-machine(); root.sidebar-open = true; } }
                        }
                        Text { text: "Sharp scaling. A familiar cursor. Your whole desktop."; color: root.muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                    }
                    if root.connected : Image {
                        x: root.draw-left * 1px; y: root.draw-top * 1px;
                        width: root.draw-width * 1px; height: root.draw-height * 1px;
                        source: root.frame-image; image-fit: fill;
                    }
                    remote-focus := FocusScope {
                        enabled: root.connected && !root.modal-open;
                        key-pressed(event) => { return root.keyboard-event(event, true) ? EventResult.accept : EventResult.reject; }
                        key-released(event) => { return root.keyboard-event(event, false) ? EventResult.accept : EventResult.reject; }
                        changed has-focus => { if !self.has-focus { root.release-input(); } }
                        remote-pointer := TouchArea {
                            private property <bool> over-video: self.mouse-x >= root.draw-left * 1px && self.mouse-y >= root.draw-top * 1px && self.mouse-x < (root.draw-left + root.draw-width) * 1px && self.mouse-y < (root.draw-top + root.draw-height) * 1px;
                            enabled: root.connected;
                            mouse-cursor: self.over-video && (root.remote-cursor-ready || root.remote-cursor-hidden) ? MouseCursor.none : MouseCursor.default;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down { remote-focus.focus(); }
                                root.pointer-event(self.mouse-x / 1px, self.mouse-y / 1px, event);
                            }
                            scroll-event(event) => { root.wheel-event(self.mouse-x / 1px, self.mouse-y / 1px, event); return EventResult.accept; }
                        }
                    }
                    if root.connected && !root.modal-open && root.remote-cursor-ready && remote-pointer.has-hover && remote-pointer.over-video : Image {
                        source: root.remote-cursor-image;
                        x: remote-pointer.mouse-x - root.remote-cursor-hotspot-x * root.remote-cursor-zoom * 1px;
                        y: remote-pointer.mouse-y - root.remote-cursor-hotspot-y * root.remote-cursor-zoom * 1px;
                        width: root.remote-cursor-width * root.remote-cursor-zoom * 1px;
                        height: root.remote-cursor-height * root.remote-cursor-zoom * 1px;
                    }
                    if root.immersive : Rectangle {
                        x: 12px; y: 12px; width: 310px; height: 40px;
                        border-radius: 10px; background: #1c1c1ee8;
                        HorizontalLayout {
                            padding: 10px; spacing: 10px;
                            Text { text: root.download-rate + " in"; color: #64aaff; font-size: 12px; vertical-alignment: center; }
                            TrafficPlot { width: 78px; samples: root.traffic; motion: root.motion-enabled; }
                            if root.show-fps : Text { text: root.fps-text; color: #ffffff; font-size: 12px; vertical-alignment: center; }
                        }
                    }
                    if root.immersive : Button {
                        x: parent.width - self.width - 12px; y: 12px;
                        width: 156px; height: 32px; text: "Exit full screen";
                        clicked => { root.fullscreen-requested(); }
                    }
                }
                if !root.immersive : Text {
                    text: root.connected ? root.desktop-description + "  |  " + root.active-encoding : root.bandwidth-description;
                    color: root.muted; font-size: 11px; overflow: elide; height: 22px;
                }
            }
        }
        if !root.immersive : GlassPanel {
            height: 48px; radius: 16px;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; padding-top: 8px; padding-bottom: 8px; spacing: 10px;
                Rectangle {
                    width: 12px;
                    background: transparent;
                    Rectangle {
                        accessible-role: text; accessible-label: "Connection status indicator";
                        width: 8px; height: 8px; x: 2px; y: (parent.height - self.height) / 2;
                        border-radius: 4px; background: root.connected ? #30d158 : (root.connecting ? #ff9f0a : #8e8e93);
                        opacity: root.connecting && root.pulse ? 0.4 : 1;
                        animate opacity { duration: root.motion-enabled ? 500ms : 0ms; }
                    }
                }
                Text { text: root.status; color: root.ink; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                TrafficPlot { accessible-role: groupbox; accessible-label: "Live network traffic, last 20 seconds"; width: 100px; samples: root.traffic; motion: root.motion-enabled; }
                VerticalLayout {
                    width: 112px; spacing: 1px;
                    Text { accessible-label: "Download rate: " + root.download-rate; text: "IN  " + root.download-rate; color: root.accent; font-size: 11px; }
                    Text { accessible-label: "Upload rate: " + root.upload-rate; text: "OUT  " + root.upload-rate; color: root.muted; font-size: 11px; }
                }
                if root.show-fps : Text { accessible-label: "Live FPS: " + root.fps-text; text: root.fps-text; color: root.ink; font-family: "Consolas"; font-size: 12px; vertical-alignment: center; min-width: 68px; }
            }
        }
    }
    }
    if root.quality-open || root.help-open : Rectangle {
        background: root.dark-theme ? #00000099 : #00000033;
        TouchArea { clicked => { root.quality-open = false; root.help-open = false; } }
        GlassPanel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(620px, parent.width - 48px); height: min(700px, parent.height - 48px);
            radius: 24px; raised: true;
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 14px;
                HorizontalLayout {
                    Text { text: root.help-open ? "Compression, explained" : "Picture & connection"; color: root.ink; font-size: 22px; font-weight: 600; }
                    Button { text: "Close"; clicked => { root.help-open = false; root.quality-open = false; } }
                }
                if root.error-text != "" : Text { text: root.error-text; color: root.dark-theme ? #ff6961 : #b42318; wrap: word-wrap; font-size: 12px; }
                if !root.help-open : ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: quality-content.preferred-height;
                    quality-content := VerticalLayout {
                        spacing: 12px; padding-left: 4px; padding-right: 16px;
                        Text { text: "Default: HEVC / H.265 at up to 60 FPS, with adaptive bitrate."; color: root.muted; font-size: 12px; wrap: word-wrap; }
                        Caption { text: "Streaming mode"; }
                        ComboBox {
                            accessible-label: "Streaming mode";
                            accessible-action-set-value(value) => { self.current-value = value; }
                            height: 36px;
                            model: ["HEVC / H.265 - 60 FPS (default)", "HEVC / H.265 - 30 FPS", "Auto (lossless VNC)", "ZRLE (lossless)", "Tight (lossless)", "Tight + JPEG (lossy)", "Hextile (lossless)", "Zlib (lossless)", "Raw (uncompressed)", "RRE (legacy)", "CoRRE (legacy)"];
                            current-index <=> root.encoding-index;
                        }
                        Text { text: root.encoding-description; color: root.muted; font-size: 12px; wrap: word-wrap; }
                        Button { text: "Compare methods & bandwidth estimates"; clicked => { root.help-open = true; } }
                        if root.encoding-index >= 2 : HorizontalLayout {
                            Caption { text: "Compression effort: " + round(root.compression-level); }
                            Slider { accessible-label: "Compression effort"; minimum: 0; maximum: 9; step: 1; value <=> root.compression-level; enabled: root.encoding-index <= 5 || root.encoding-index == 7; }
                        }
                        if root.encoding-index >= 2 : Text { text: "0 = less CPU, potentially more traffic. 9 = more CPU, potentially fewer bytes. This is a server hint, not a bitrate."; color: root.muted; font-size: 11px; wrap: word-wrap; }
                        if root.encoding-index == 5 : HorizontalLayout {
                            Caption { text: "JPEG quality: " + round(root.jpeg-quality); }
                            Slider { accessible-label: "JPEG quality"; minimum: 0; maximum: 9; step: 1; value <=> root.jpeg-quality; }
                        }
                        if root.encoding-index >= 2 : CheckBox { text: "Use a manual bandwidth target"; checked <=> root.manual-bandwidth; }
                        if root.encoding-index < 2 : CheckBox { text: "Use a manual HEVC bitrate ceiling"; checked <=> root.manual-hevc-bitrate; }
                        if root.manual-hevc-bitrate && root.encoding-index < 2 : HorizontalLayout {
                            Caption { text: "HEVC bitrate (Mbps)"; }
                            LineEdit { accessible-label: "HEVC bitrate Mbps"; text <=> root.hevc-mbps; input-type: InputType.decimal; }
                        }
                        if root.manual-bandwidth && root.encoding-index >= 2 : HorizontalLayout {
                            Caption { text: "Target (Mbps)"; }
                            LineEdit { accessible-label: "Bandwidth target Mbps"; text <=> root.target-mbps; input-type: InputType.decimal; }
                        }
                        Text { text: root.encoding-index < 2 ? "Adaptive bitrate is the default. A manual ceiling requests your chosen Mbps from the Mac; static screens and encoder limits can lower the actual rate, and bursts may exceed it. Compression, JPEG quality and the VNC bandwidth target do not apply. Apply reconnects when changing transports, HEVC presets or the bitrate ceiling; saved logins require Windows Hello again." : "Automatic means no bandwidth target. A manual target spaces screen requests based on received bytes; bursts can exceed it. Apply reconnects automatically when switching to or from HEVC. Other VNC changes apply live."; color: root.muted; font-size: 12px; wrap: word-wrap; }
                        HorizontalLayout {
                            Caption { text: "Frame rate limit"; }
                            LineEdit { accessible-label: "Maximum FPS"; width: 88px; text <=> root.max-fps; input-type: InputType.number; }
                        }
                        CheckBox { text: "Show live FPS counter"; checked <=> root.show-fps; toggled => { root.save-preferences(); } }
                        Text { text: "FPS counts unique desktop images submitted for display, not monitor refreshes. An idle desktop correctly reads 0 FPS. Traffic measures VNC, HEVC/audio SRTP and SSH payloads in bits/s, excluding TCP/UDP/VPN overhead."; color: root.muted; font-size: 11px; wrap: word-wrap; }
                    }
                }
                if root.help-open : ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: guide-content.preferred-height;
                    guide-content := VerticalLayout {
                        spacing: 16px; padding-right: 16px;
                        Text { text: root.estimate-context; color: root.muted; font-size: 12px; wrap: word-wrap; }
                        for codec in root.codec-guide : VerticalLayout {
                            spacing: 6px;
                            Caption { text: codec.name; color: root.accent; }
                            Text { text: codec.detail; color: root.ink; font-size: 12px; wrap: word-wrap; }
                            Text { text: codec.estimate; color: root.muted; font-size: 11px; wrap: word-wrap; }
                            Rectangle { height: 1px; background: root.outline; }
                        }
                        Text {
                            text: "Standard VNC offers CopyRect and a Raw fallback; the Mac may ignore compression/JPEG hints. HEVC uses Apple's separate High Performance transport with encrypted control, SRTP video and optional audio. Video decoding is bundled; audio uses a separate converter. Mac account login and UDP on the VNC port and the next port are required. H.264 playback is not supported.";
                            color: root.muted; font-size: 12px; wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    Button { text: root.help-open ? "Back to quality" : "Restore defaults"; clicked => { if root.help-open { root.help-open = false; } else { root.reset-streaming(); } } }
                    Rectangle { background: transparent; horizontal-stretch: 1; }
                    if !root.help-open : Button { text: "Apply"; primary: true; enabled: !root.connecting && !root.update-installing && root.audit-error == ""; clicked => { root.apply-streaming(); } }
                }
            }
        }
    }
    if root.audio-open : AudioOverlay {
        supported: root.hevc-active; connected: root.connected; missing: root.audio-codec-missing;
        installing: root.audio-installing; status: root.audio-status;
        muted <=> root.audio-muted; volume <=> root.audio-volume;
        changed => { root.audio-changed(); }
        install => { root.audio-install(); }
        retry => { root.audio-retry(); }
        close => { root.audio-open = false; if root.connected { root.focus-canvas(); } }
    }
    if root.about-open : AboutOverlay {
        version: root.app-version; build-date: root.build-date; revision: root.build-revision;
        target: root.build-target; compiler: root.build-compiler; author: root.author-name; log-path: root.log-path;
        close => { root.about-open = false; if root.connected { root.focus-canvas(); } }
        open-link(index) => { root.about-link(index); }
        open-logs => { root.open-logs(); }
    }

    if root.clipboard-open : ClipboardOverlay {
        shared <=> root.clipboard-shared; mode: root.clipboard-mode; vnc-available: !root.hevc-active;
        host: root.files-host; port <=> root.files-port; username <=> root.files-username; password <=> root.files-password;
        has-saved: root.files-has-saved; use-saved <=> root.files-use-saved; connected: root.files-connected;
        connecting: root.files-connecting; busy: root.files-busy; key-pending: root.files-key-pending;
        fingerprint: root.files-fingerprint; key-algorithm: root.files-key-algorithm; key-command: root.files-key-command;
        status: root.files-status; error: root.files-error; progress: root.files-progress; progress-label: root.files-progress-label;
        changed => { root.clipboard-changed(); }
        close => { root.close-clipboard(); }
        paste-text => { root.paste-windows-text(); }
        connect => { root.files-connect(); }
        disconnect => { root.files-disconnect(); }
        approve(accepted) => { root.files-approve(accepted); }
        cancel => { root.files-cancel(); }
        copy-text => { root.files-copy-text(); }
        send-text => { root.files-send-text(); }
    }

    if root.files-open : FilesOverlay {
        host: root.files-host; port <=> root.files-port; username <=> root.files-username; password <=> root.files-password;
        has-saved: root.files-has-saved; use-saved <=> root.files-use-saved; connected: root.files-connected;
        connecting: root.files-connecting; busy: root.files-busy; key-pending: root.files-key-pending;
        directory-ready: root.files-directory-ready;
        fingerprint: root.files-fingerprint; key-algorithm: root.files-key-algorithm; key-command: root.files-key-command;
        path <=> root.files-path; upload-name <=> root.files-upload-name; entries: root.file-entries;
        status: root.files-status; error: root.files-error; progress: root.files-progress; progress-label: root.files-progress-label;
        close => { root.files-close(); }
        connect => { root.files-connect(); }
        disconnect => { root.files-disconnect(); }
        approve(accepted) => { root.files-approve(accepted); }
        browse => { root.files-browse(); }
        up => { root.files-up(); }
        entry(index) => { root.files-entry(index); }
        upload => { root.files-upload(); }
        cancel => { root.files-cancel(); }
    }

    if root.update-banner && !root.update-installing && !root.modal-open : GlassPanel {
        x: max(16px, root.width - self.width - 20px);
        y: root.immersive ? 60px : 88px;
        width: min(390px, root.width - 32px); height: 166px; radius: 18px; raised: true;
        accessible-role: groupbox; accessible-label: "MacCanvas update notification";
        TouchArea { }
        VerticalLayout {
            padding: 18px; spacing: 10px;
            Text { text: root.update-restart-required ? "Restart required" : (root.update-available ? "MacCanvas " + root.update-version + " is ready" : "Update check"); color: root.ink; font-size: 16px; font-weight: 600; }
            Text {
                text: root.update-available && (root.connected || root.connecting) ? "Disconnect when you're ready to install and restart. Your saved Macs and logins will stay." : root.update-status;
                color: root.muted; wrap: word-wrap; font-size: 12px;
            }
            HorizontalLayout {
                Button { text: "Later"; clicked => { root.dismiss-update(); } }
                Rectangle { background: transparent; horizontal-stretch: 1; }
                Button {
                    text: root.update-restart-required ? "Restart needed" : (root.update-available ? "Update & restart" : "Retry");
                    primary: true; enabled: !root.update-checking && !root.connected && !root.connecting && !root.update-restart-required;
                    clicked => { if root.update-available { root.install-update(); } else { root.check-updates(); } }
                }
            }
        }
    }
    if root.update-installing : Rectangle {
        background: #00000066;
        TouchArea { }
        GlassPanel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(460px, parent.width - 48px); height: 180px; radius: 22px; raised: true;
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Text { text: "Updating MacCanvas"; color: root.ink; font-size: 21px; font-weight: 600; }
                Text { text: root.update-status; color: root.muted; wrap: word-wrap; font-size: 13px; }
                Rectangle {
                    height: 5px; border-radius: 3px; background: root.outline;
                    Rectangle { width: parent.width * root.update-progress; background: root.accent; border-radius: 3px; }
                }
                Text { text: "Keep this window open. MacCanvas will restart when ready."; color: root.muted; font-size: 11px; wrap: word-wrap; }
            }
        }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => { return accept; }
            key-released(event) => { return accept; }
        }
    }
}
