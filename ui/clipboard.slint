import { GlassTheme, GlassPanel, Button, CheckBox } from "glass.slint";

export component ClipboardOverlay inherits Rectangle {
    in-out property <bool> shared;
    in property <string> mode;
    callback changed();
    callback close();
    callback paste-text();
    callback ssh-files();
    background: GlassTheme.dark ? #00000099 : #00000033;
    TouchArea { clicked => { root.close(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => { if event.text == Key.Escape { root.close(); return accept; } return reject; }
        GlassPanel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(540px, parent.width - 48px); height: min(500px,parent.height - 40px); radius: 24px; raised: true;
            TouchArea { }
            VerticalLayout {
                padding: 26px; spacing: 16px;
                HorizontalLayout {
                    Text { text: "Clipboard"; color: GlassTheme.ink; font-size: 23px; font-weight: 700; }
                    Button { text: "Done"; clicked => { root.close(); } }
                }
                CheckBox { text: "Share plain-text clipboard over VNC"; checked <=> root.shared; toggled => { root.changed(); } }
                Text { text: root.mode; color: GlassTheme.accent; font-size: 12px; wrap: word-wrap; }
                Text { text: "Ctrl+V sends Windows text when pasting into your Mac. Incoming Mac text can replace your Windows clipboard while the viewer is active. Clipboard contents are never logged."; color: GlassTheme.muted; wrap: word-wrap; font-size: 13px; }
                Text { text: "VNC clipboard traffic is not encrypted. Use a VPN. Files, images, and rich text are not shared."; color: GlassTheme.muted; wrap: word-wrap; font-size: 12px; }
                HorizontalLayout {
                    Button { text: "Paste Windows text"; enabled: root.shared; clicked => { root.paste-text(); } }
                    Button { text: "Encrypted SSH clipboard"; clicked => { root.ssh-files(); } }
                }
                Text { text: "SSH also supports Unicode on Macs without the VNC UTF-8 extension. It requires macOS Remote Login."; color: GlassTheme.muted; wrap: word-wrap; font-size: 11px; }
            }
        }
    }
}
